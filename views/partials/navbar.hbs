<header class="topbar">
  <div class="brand">
    <div class="logo">J&F</div>
    <h1>Plataforma de Ideias</h1>
  </div>
  <nav class="nav-right">
    {{#if currentUser}}
      <span class="user">Olá, {{currentUser.name}}</span>
      <a class="btn" href="/profile">Perfil</a>
      <form action="/auth/logout" method="post" style="display:inline;">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button class="btn btn-ghost">Logout</button>
      </form>
    {{else}}
      <a class="btn" href="/auth/login">Login</a>
      <a class="btn" href="/auth/register">Cadastrar</a>
    {{/if}}
  </nav>
</header>