<header class="bg-blue-900 text-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-white p-2 rounded">
          <i class="fas fa-lightbulb text-blue-900"></i>
        </div>
        <div>
          <h1 class="text-xl">Instituto J&F</h1>
          <p class="text-sm text-blue-200">Plataforma de Ideias</p>
        </div>
      </div>
      
      <nav class="flex items-center gap-4">
        <a href="/dashboard" 
           class="btn {{#if (eq currentPage 'dashboard')}}btn-secondary{{else}}btn-ghost{{/if}} text-white hover:bg-blue-800">
          <i class="fas fa-home mr-2"></i>
          Ideias
        </a>
        
        <a href="/profile" 
           class="btn {{#if (eq currentPage 'profile')}}btn-secondary{{else}}btn-ghost{{/if}} text-white hover:bg-blue-800">
          <i class="fas fa-user mr-2"></i>
          Perfil
        </a>
        
        {{#if user}}
        <div class="flex items-center gap-3 ml-4 pl-4 border-l border-blue-700">
          <div class="text-right">
            <p class="text-sm">{{user.name}}</p>
            <p class="text-xs text-blue-200">{{user.department}}</p>
          </div>
          <form action="/logout" method="POST" class="inline">
            <button type="submit" class="btn btn-ghost text-white hover:bg-blue-800">
              <i class="fas fa-sign-out-alt"></i>
            </button>
          </form>
        </div>
        {{/if}}
      </nav>
    </div>
  </div>
</header>