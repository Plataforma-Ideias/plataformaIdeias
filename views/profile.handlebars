<div class="max-w-5xl mx-auto space-y-6">
  <div>
    <h2 class="text-3xl text-gray-900">Meu Perfil</h2>
    <p class="text-gray-600 mt-1">Suas informações e contribuições</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="card md:col-span-1">
      <div class="card-header">
        <h3 class="card-title">Informações</h3>
      </div>
      <div class="card-content space-y-4">
        <div>
          <p class="text-2xl text-gray-900">{{user.name}}</p>
        </div>
        
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-gray-600">
            <i class="fas fa-envelope w-4 h-4"></i>
            <span class="text-sm">{{user.email}}</span>
          </div>
          
          <div class="flex items-center gap-2 text-gray-600">
            <i class="fas fa-building w-4 h-4"></i>
            <span class="text-sm">{{user.department}}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title flex items-center gap-2">
          <i class="fas fa-lightbulb text-lime-600"></i>
          Ideias Criadas
        </h3>
      </div>
      <div class="card-content">
        <p class="text-4xl text-lime-600">{{ideas.length}}</p>
        <p class="text-sm text-gray-600 mt-2">
          {{#if (eq ideas.length 1)}}ideia publicada{{else}}ideias publicadas{{/if}}
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title flex items-center gap-2">
          <i class="fas fa-thumbs-up text-blue-600"></i>
          Votos Recebidos
        </h3>
      </div>
      <div class="card-content">
        <p class="text-4xl text-blue-600">{{totalVotes}}</p>
        <p class="text-sm text-gray-600 mt-2">
          {{#if (eq totalVotes 1)}}voto total{{else}}votos totais{{/if}}
        </p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Minhas Ideias</h3>
      <p class="card-description">
        Todas as propostas que você enviou para a plataforma
      </p>
    </div>
    <div class="card-content">
      {{#if ideas.length}}
        <div class="space-y-4">
          {{#each ideas}}
          <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="badge {{getCategoryColor category}} text-white">
                    {{category}}
                  </span>
                  <span class="flex items-center gap-1 text-sm text-gray-600">
                    <i class="fas fa-thumbs-up w-4 h-4"></i>
                    {{votes.length}}
                  </span>
                </div>
                <h3 class="text-lg text-gray-900 mb-1">{{title}}</h3>
                <p class="text-sm text-gray-600 line-clamp-2">
                  {{description}}
                </p>
              </div>
              <a 
                href="/ideas/{{id}}"
                class="btn btn-outline btn-sm"
              >
                <i class="fas fa-eye mr-1"></i>
                Ver
              </a>
            </div>
          </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-8">
          <i class="fas fa-lightbulb fa-3x text-gray-400 mb-3"></i>
          <p class="text-gray-600">Você ainda não criou nenhuma ideia.</p>
          <p class="text-sm text-gray-500">Comece compartilhando suas propostas!</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>