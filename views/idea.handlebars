<div class="max-w-4xl mx-auto space-y-6">
  <a href="/dashboard" class="btn btn-ghost">
    <i class="fas fa-arrow-left mr-2"></i>
    Voltar para Ideias
  </a>

  <div class="card">
    <div class="card-header">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge {{getCategoryColor idea.category}} text-white">
              {{idea.category}}
            </span>
            {{#if (eq idea.authorId currentUser.id)}}
              <span class="badge badge-outline border-blue-600 text-blue-600">
                Sua Ideia
              </span>
            {{/if}}
          </div>
          <h1 class="text-3xl mb-2">{{idea.title}}</h1>
          <div class="flex items-center gap-4 text-base text-gray-500">
            <span class="flex items-center gap-1">
              <i class="fas fa-user"></i>
              {{idea.authorName}}
            </span>
            <span class="flex items-center gap-1">
              <i class="fas fa-calendar"></i>
              {{formatDate idea.createdAt}}
            </span>
          </div>
        </div>

        <div class="text-center bg-blue-50 px-6 py-4 rounded-lg">
          <i class="fas fa-thumbs-up text-blue-600 fa-2x mb-2"></i>
          <p class="text-3xl text-blue-600">{{idea.votes.length}}</p>
          <p class="text-sm text-gray-600">votos</p>
        </div>
      </div>
    </div>
    
    <hr class="separator" />
    
    <div class="card-content pt-6">
      <div class="space-y-6">
        <div>
          <h3 class="text-lg text-gray-900 mb-3">Descrição da Ideia</h3>
          <p class="text-gray-700 leading-relaxed whitespace-pre-wrap">
            {{idea.description}}
          </p>
        </div>

        <hr class="separator" />

        <div class="flex gap-3">
          {{#unless (eq idea.authorId currentUser.id)}}
            <form action="/ideas/{{idea.id}}/vote" method="POST" class="flex-1">
              <button 
                type="submit"
                class="btn w-full {{#if (hasVoted idea.votes currentUser.id)}}btn-secondary{{else}}bg-blue-600 hover:bg-blue-700{{/if}}"
                {{#if (hasVoted idea.votes currentUser.id)}}disabled{{/if}}
              >
                <i class="fas fa-thumbs-up mr-2"></i>
                {{#if (hasVoted idea.votes currentUser.id)}}
                  Você já votou nesta ideia
                {{else}}
                  Votar nesta Ideia
                {{/if}}
              </button>
            </form>
          {{/unless}}

          {{#if (eq idea.authorId currentUser.id)}}
            <a 
              href="/ideas/{{idea.id}}/edit"
              class="btn flex-1 bg-blue-600 hover:bg-blue-700"
            >
              <i class="fas fa-edit mr-2"></i>
              Editar Ideia
            </a>
            <form action="/ideas/{{idea.id}}/delete" method="POST" class="flex-1"
                  onsubmit="return confirm('Tem certeza que deseja excluir esta ideia?');">
              <button 
                type="submit"
                class="btn btn-destructive w-full"
              >
                <i class="fas fa-trash mr-2"></i>
                Excluir Ideia
              </button>
            </form>
          {{/if}}
        </div>

        {{#if (and (hasVoted idea.votes currentUser.id) (not (eq idea.authorId currentUser.id)))}}
          <div class="alert bg-green-50 border-green-200">
            <i class="fas fa-thumbs-up text-green-600"></i>
            <p class="text-green-800">
              Obrigado pelo seu voto! Você está ajudando a impulsionar esta ideia.
            </p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>