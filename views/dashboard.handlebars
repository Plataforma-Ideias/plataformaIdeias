<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-3xl text-gray-900">Ideias em Destaque</h2>
      <p class="text-gray-600 mt-1">Explore e vote nas melhores propostas</p>
    </div>
    <a href="/ideas/new" class="btn bg-lime-600 hover:bg-lime-700">
      <i class="fas fa-plus mr-2"></i>
      Nova Ideia
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {{#each ideas}}
    <div class="card hover:shadow-lg transition-shadow">
      <div class="card-header">
        <div class="flex items-start justify-between gap-2">
          <span class="badge {{getCategoryColor category}} text-white">
            {{category}}
          </span>
          <div class="flex items-center gap-1 text-gray-600">
            <i class="fas fa-thumbs-up"></i>
            <span>{{votes.length}}</span>
          </div>
        </div>
        <h3 class="card-title mt-2">{{title}}</h3>
        <p class="card-description">Por {{authorName}}</p>
      </div>
      <div class="card-content">
        <p class="text-gray-600 text-sm line-clamp-3 mb-4">
          {{description}}
        </p>
        
        <div class="flex gap-2">
          <a href="/ideas/{{id}}" class="btn btn-outline btn-sm flex-1">
            <i class="fas fa-eye mr-1"></i>
            Ver
          </a>
          
          {{#unless (eq authorId ../currentUser.id)}}
            <form action="/ideas/{{id}}/vote" method="POST" class="inline">
              <button type="submit" 
                      class="btn btn-sm {{#if (hasVoted votes ../currentUser.id)}}btn-secondary{{else}}bg-blue-600 hover:bg-blue-700{{/if}}"
                      {{#if (hasVoted votes ../currentUser.id)}}disabled{{/if}}>
                <i class="fas fa-thumbs-up mr-1"></i>
                {{#if (hasVoted votes ../currentUser.id)}}Votado{{else}}Votar{{/if}}
              </button>
            </form>
          {{/unless}}
          
          {{#if (eq authorId ../currentUser.id)}}
            <a href="/ideas/{{id}}/edit" class="btn btn-outline btn-sm">
              <i class="fas fa-edit"></i>
            </a>
            <form action="/ideas/{{id}}/delete" method="POST" class="inline"
                  onsubmit="return confirm('Tem certeza que deseja excluir esta ideia?');">
              <button type="submit" class="btn btn-outline btn-sm text-red-600 hover:text-red-700">
                <i class="fas fa-trash"></i>
              </button>
            </form>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  {{#unless ideas.length}}
  <div class="text-center py-12">
    <div class="text-gray-400 mb-4">
      <i class="fas fa-plus fa-4x"></i>
    </div>
    <p class="text-gray-600">Nenhuma ideia cadastrada ainda.</p>
    <p class="text-gray-500 text-sm">Seja o primeiro a compartilhar!</p>
  </div>
  {{/unless}}
</div>